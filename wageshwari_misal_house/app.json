{
  "expo": {
    "name": "Wagheshwar Misal House",
    "slug": "wageshwari_misal_house",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wageshwarimisalhouse",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.wagheshwar.misalhouse",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#8E1B1B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8E1B1B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wagheshwar Misal House uses your location to check that your delivery address is within 3 km of the hotel.",
          "motionUsagePermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ef2a55a3-1140-43e8-af6c-d031383a63c3"
      }
    },
    "owner": "tusharkulanges-team"
  }
}
